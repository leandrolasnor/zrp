// For format details, see https://aka.ms/devcontainer.json.
{
  "name": "ZRP project development",
  "remoteUser": "root",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "api",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "runServices": [
    "db", "meilisearch",
    "pgadmin", "redis", "rabbitmq",
    "socket.io.server", "socket.io.client", "dozzle"
  ],
  "forwardPorts": [3000, 28080, 8888],
  "postCreateCommand": ".devcontainer/boot",
  "postStartCommand": ".devcontainer/start",
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "eamodio.gitlens",
        "donjayamanne.githistory",
        "EditorConfig.EditorConfig",
        "MS-CEINTL.vscode-language-pack-pt-BR",
        "shyykoserhiy.git-autoconfig",
        "AiryShift.spaces-inside-braces",
        "naumovs.color-highlight",
        "bierner.github-markdown-preview",
        "karunamurti.rspec-snippets",
        "miguelsolorio.symbols",
        "drcika.apc-extension",
        "DrBlury.protobuf-vsc",
        "lyn-inc.HTML-Speed-Viewer",
        "SterRoque.ai-commit-generator",
        "sitoi.ai-commit",
        "first-try-software.coverage-status",
        "GitHub.copilot-chat",
        "ms-azuretools.vscode-containers",
        "KoichiSasada.vscode-rdbg",
        "kaiwood.endwise",
        "sevenc-nanashi.gemfile-lock-highlight"
      ]
    }
  }
}
